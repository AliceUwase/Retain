# the setting names the API reads; the real values live in .env, which git ignores
PORT=4000
NODE_ENV=development

# from Atlas: Connect → Drivers, with the database name "retain" added before the "?"
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/retain?retryWrites=true&w=majority

# logins the seed script creates (npm run seed); passwords are only stored hashed
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_DEMO_EMAIL=
SEED_DEMO_PASSWORD=
